{
  "name": "hotdrones",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:basic": "vite BASIC --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:basic": "tsc --noEmit -p BASIC",
    "experiment": "tsx scripts/experiment.ts",
    "experiment:basic": "cd BASIC && tsx scripts/experiment.ts",
    "experiment:legacy-check": "tsx scripts/experiment.ts --legacy && tsx scripts/check-legacy.ts",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "audio:generate": "tsx scripts/audio-generate.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "test:integrations": "tsx scripts/test-integrations.ts",
    "test:voice": "node --import tsx scripts/test-voice.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@google/genai": "^3.3.0",
    "dotenv": "^18.0.10",
    "mongodb": "^7.9.0",
    "pg": "^8.23.1",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  }
}
